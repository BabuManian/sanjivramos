#camp{left:50%;top:58px;transform:translateX(-50%);font-size:13px;font-weight:700;text-shadow:0 1px 3px #000;padding:3px 12px;border-radius:999px;background:rgba(0,0,0,.35)}
#vig{position:fixed;inset:0;pointer-events:none;z-index:1;box-shadow:inset 0 0 160px rgba(0,0,0,.75);transition:box-shadow .4s}
