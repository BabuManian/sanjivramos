<script>
/* Play with friends (SanjivramOS rooms): everyone sees everyone else's character live, with name tags */
let F = null;
const fTags = document.createElement('div'); fTags.style.cssText = 'position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:3'; document.body.appendChild(fTags);
async function goOnline(game, gameName, then) {
  if (!window.SJFriends || !(await SJFriends.available())) { alert('Playing with friends needs SanjivramOS (open this game from the SanjivramOS desktop).'); return; }
  if (F) { then(); return; }
  try { F = await SJFriends.join({ game, gameName }); } catch { return; }
  then();
}
</script>

<script>
(() => {
'use strict';
const kit = window.SJG ? SJG.init('lantern', { title: 'Lantern Woods', vs: false, trophies: [
  { id: 'night1', name: 'First Night', desc: 'Survive a night', icon: '🌙' },
