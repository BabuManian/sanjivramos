  { id: 'night10', name: 'Old Hand', desc: 'Survive 10 nights in one game', icon: '🌑' },
  { id: 'page', name: 'Grandpa’s Words', desc: 'Find a journal page', icon: '📜' },
  { id: 'allpages', name: 'The Whole Story', desc: 'Find all 8 journal pages', icon: '📖' },
  { id: 'stone', name: 'Warm Light', desc: 'Find a Sunstone', icon: '🔆' },
  { id: 'warden', name: 'Not Tonight', desc: 'Drive away the Pale Warden', icon: '🕯️' },
  { id: 'crafter', name: 'Handy', desc: 'Craft every tool', icon: '🛠️' },
  { id: 'lumber', name: 'Lumberjack', desc: 'Chop 40 trees', icon: '🪓' },
  { id: 'beacon', name: 'Keeper of the Light', desc: 'Wake the Beacon and finish the story', icon: '🏮' },
  { id: 'endless15', name: 'Endless Ember', desc: 'Survive 15 nights in Endless', icon: '🔥' },
  { id: 'wolf', name: 'Wolfbane', desc: 'Beat a wolf', icon: '🐺' },
  { id: 'pack', name: 'Pack Leader', desc: 'Beat 15 wolves', icon: '🌕' },
  { id: 'alpha', name: 'Top Dog', desc: 'Beat an alpha wolf', icon: '👑' },
  { id: 'bear', name: 'Bear Necessities', desc: 'Beat the bear', icon: '🐻' },
  { id: 'armed', name: 'Locked and Loaded', desc: 'Find the revolver', icon: '🔫' },
  { id: 'cook', name: 'Camp Cook', desc: 'Cook 10 pieces of meat', icon: '🍖' },
  { id: 'farmer', name: 'Green Thumb', desc: 'Harvest a crop', icon: '🥕' },
  { id: 'angler', name: 'Gone Fishing', desc: 'Catch a fish', icon: '🎣' },
  { id: 'golden', name: 'Golden Catch', desc: 'Catch the golden fish', icon: '✨' },
  { id: 'trapper', name: 'Snap!', desc: 'Catch something in a trap', icon: '🪤' },
  { id: 'raid', name: 'Hold the Line', desc: 'Drive off a raid', icon: '🛡️' },
  { id: 'storm', name: 'Weathered', desc: 'Survive a thunderstorm night', icon: '⛈️' },
] }) : null;
const G3 = window.GL3D, { M, hex, dirOf, pushBox, pushCone, pushTerrain } = G3;
const $ = id => document.getElementById(id);
const TEST = /[?&]nogl\b/.test(location.search);
const cv = $('gl');
let R = null;
if (!TEST) { try { R = G3.create(cv, { maxDpr: matchMedia('(pointer: coarse)').matches ? 1 : 1.25 }); /* phones: full-res pixels are the biggest cost */ } catch (e) { console.warn(e); } }
if (!R && !TEST) { $('menu').querySelector('.sub').innerHTML = 'This browser can’t run WebGL, so the 3D woods can’t be drawn here. Try Chrome or Firefox with hardware acceleration on.'; }
const IN = G3.Input(cv);
IN.bindButtons($('touch'));
const sfx = n => kit && kit.sfx(n);
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const lerp = (a, b, t) => a + (b - a) * t;
const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };

/* =================== WORLD =================== */
const HALF = 100, SEED = 7741, rnd = G3.rng(SEED), N1 = G3.noise2(SEED), N2 = G3.noise2(SEED + 9);
const LAKE = [60, 50, 15];
const LM = {   // landmarks
  camp: { x: 0, z: 0, name: 'Camp' },
  cabin: { x: 42, z: -30, name: 'Ranger cabin' },
  stones: { x: -55, z: -45, name: 'Standing stones' },
  dock: { x: 60, z: 50, name: 'Lake dock' },
  tower: { x: -60, z: 55, name: 'Fire watchtower' },
  cave: { x: 4, z: 60, name: 'Hollow cave' },
  mill: { x: -82, z: 2, name: 'Old mill' },
  oldcamp: { x: 78, z: -72, name: 'Abandoned camp' },
};
const inCaveRock = (x, z) => Math.abs(x - LM.cave.x) < 9.5 && z > LM.cave.z - 1.5 && z < LM.cave.z + 24.5;
function rawH(x, z) {
  let h = (N1(x * 0.035 + 50, z * 0.035 + 50) - 0.5) * 7 + (N2(x * 0.11 + 9, z * 0.11 + 9) - 0.5) * 1.6;
  h *= smooth(9, 22, Math.hypot(x, z));
  for (const k in LM) if (k !== 'camp' && k !== 'dock') { const l = LM[k], d = Math.hypot(x - l.x, z - l.z); h = lerp(h, 0.3, 1 - smooth(7, 15, d)); }
  const dl = Math.hypot(x - LAKE[0], z - LAKE[1]); if (dl < LAKE[2]) h -= (1 - dl / LAKE[2]) ** 1.5 * 5;
  h += smooth(80, 100, Math.max(Math.abs(x), Math.abs(z))) * 6;   // hills at the edge of the map
  if (inCaveRock(x, z)) h = Math.min(h, 0);   // the cave's rock covers this
  return h;
}
// ground = exactly the triangles we draw (step 2.5)
const STEP = 2.5, GN = HALF * 2 / STEP + 1, HG = new Float32Array(GN * GN);
for (let i = 0; i < GN; i++) for (let j = 0; j < GN; j++) HG[i * GN + j] = rawH(-HALF + i * STEP, -HALF + j * STEP);
function groundH(x, z) {
  const fx = (clamp(x, -HALF, HALF - 0.001) + HALF) / STEP, fz = (clamp(z, -HALF, HALF - 0.001) + HALF) / STEP, i = fx | 0, j = fz | 0, u = fx - i, v = fz - j;
  const a = HG[i * GN + j], b = HG[(i + 1) * GN + j], c = HG[(i + 1) * GN + j + 1], d = HG[i * GN + j + 1];
  return u >= v ? a + (b - a) * u + (c - b) * v : a + (c - d) * u + (d - a) * v;
}
const WATER_Y = -1.4;
const onPath = (x, z) => { let best = 99; for (const k in LM) { if (k === 'camp') continue; const l = LM[k], L2 = l.x * l.x + l.z * l.z, t = clamp((x * l.x + z * l.z) / L2, 0, 1); best = Math.min(best, Math.hypot(x - l.x * t, z - l.z * t)); } return best; };
function groundCol(x, z, h) {
  if (h < WATER_Y + 0.4) return '#8a7d5a';
  const p = onPath(x, z); if (p < 1.6) return '#6b5a3c';
  const n = N2(x * 0.2, z * 0.2), d = Math.hypot(x, z);
  if (d < 9) return n > 0.5 ? '#5c6b38' : '#56633a';
  return n > 0.66 ? '#3f6b2e' : n > 0.33 ? '#365f29' : '#2f5524';
}

// --- static things: trees, rocks, bushes, scrap (grouped in chunks so chopping a tree rebuilds only its chunk)
const CH = 25, NCH = HALF * 2 / CH;
const trees = [], rocks = [], bushes = [], scraps = [];
const nearLM = (x, z, r) => { for (const k in LM) if (Math.hypot(x - LM[k].x, z - LM[k].z) < r) return true; return false; };
for (let i = 0; i < 1100 && trees.length < 760; i++) {
  const x = (rnd() * 2 - 1) * (HALF - 3), z = (rnd() * 2 - 1) * (HALF - 3);
  if (Math.hypot(x, z) < 12 || nearLM(x, z, 10) || inCaveRock(x, z) || Math.hypot(x - LAKE[0], z - LAKE[1]) < LAKE[2] + 1 || onPath(x, z) < 2.2) continue;
  trees.push({ id: trees.length, x, z, s: 0.8 + rnd() * 0.7, kind: rnd() < 0.78 ? 0 : 1, hp: 0, alive: true, y: groundH(x, z) });
