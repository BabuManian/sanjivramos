.card{width:min(760px,calc(100% - 24px));max-height:calc(100% - 24px);overflow:auto;background:linear-gradient(180deg,#141b2d,#0c1120);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:20px 22px;box-shadow:0 30px 80px rgba(0,0,0,.6)}
h1{margin:0;font:800 40px/1.05 Georgia,serif;letter-spacing:1px;color:#fde68a;text-shadow:0 0 24px rgba(251,191,36,.45)}
