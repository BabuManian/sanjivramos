    for (const [i, s] of st.slides) if (s.video) { if (i === st.idx) { if (s.video.paused && !s.userPaused) { s.video.muted = !st.sound; startPlaying(s.video, () => { st.sound = false; soundIcons(); hint(s); }); } } else { s.video.pause(); s.userPaused = false; if (s.video.currentTime > 0 && Math.abs(i - st.idx) === 1) try { s.video.currentTime = 0; } catch {} } }
    const cur = st.slides.get(st.idx); if (cur) { addTo('history', { ...cur.v, short: true }); }
  }
  const hint = s => { const box = $('.sbox', s.el); if (!$('.snd', box)) box.insertAdjacentHTML('beforeend', `<div class="snd">${ic('mute')} Tap for sound</div>`); };
  const soundIcons = () => { for (const s of st.slides.values()) { const b = $('[data-a=sound] i', s.el); if (b) b.innerHTML = ic(st.sound ? 'vol' : 'mute'); if (s.video) s.video.muted = !st.sound; if (st.sound) { const h = $('.snd', s.el); if (h && !/⚠/.test(h.textContent)) h.remove(); } } };
  function goTo(d) { const n = Math.max(0, Math.min(st.items.length - 1, st.idx + d)); if (n !== st.idx) { st.idx = n; } layout(0, true); }
  // touch / mouse drag
  let y0 = null, t0 = 0, dy = 0, moved = false;
  const down = e => { if (e.target.closest('.sacts,.snav,[data-ch],.sbar')) return; y0 = e.clientY; t0 = performance.now(); dy = 0; moved = false; root.setPointerCapture && root.setPointerCapture(e.pointerId); };
  const move = e => { if (y0 == null) return; dy = e.clientY - y0; if (Math.abs(dy) > 6) moved = true; if (moved) { const edge = (st.idx === 0 && dy > 0) || (st.idx >= st.items.length - 1 && dy < 0); layout(edge ? dy * 0.3 : dy); } };
  const up = () => {
    if (y0 == null) return; const h = root.clientHeight, v = dy / Math.max(1, performance.now() - t0); y0 = null;
    if (!moved) { const s = st.slides.get(st.idx); if (s && s.video) { if (!st.sound) { st.sound = true; soundIcons(); s.video.muted = false; if (s.video.paused) s.video.play().catch(() => {}); return; } const box = $('.sbox', s.el); $$('.big', box).forEach(x => x.remove()); if (s.video.paused) { s.userPaused = false; s.video.play().catch(() => {}); } else { s.userPaused = true; s.video.pause(); box.insertAdjacentHTML('beforeend', `<div class="big">${ic('pause')}</div>`); } } return; }
    if (dy < -h * 0.15 || v < -0.5) goTo(1); else if (dy > h * 0.15 || v > 0.5) goTo(-1); else layout(0, true);
  };
  root.addEventListener('pointerdown', down); root.addEventListener('pointermove', move); root.addEventListener('pointerup', up); root.addEventListener('pointercancel', up);
  let wheelLock = 0; root.addEventListener('wheel', e => { e.preventDefault(); if (Math.abs(e.deltaY) < 12 || performance.now() < wheelLock) return; wheelLock = performance.now() + 450; goTo(e.deltaY > 0 ? 1 : -1); }, { passive: false });
  const key = e => { if (view !== 'shorts' || /INPUT|SELECT/.test(e.target.tagName)) return; if (e.key === 'ArrowDown' || e.key === 'j') { e.preventDefault(); goTo(1); } if (e.key === 'ArrowUp' || e.key === 'k') { e.preventDefault(); goTo(-1); } if (e.key === 'm') { st.sound = !st.sound; soundIcons(); } if (e.key === ' ') { e.preventDefault(); const s = st.slides.get(st.idx); s && s.video && (s.video.paused ? s.video.play() : s.video.pause()); } };
  addEventListener('keydown', key); st.cleanup.push(() => removeEventListener('keydown', key));
  root.addEventListener('click', e => {
    const n = e.target.closest('[data-nav]'); if (n) { goTo(+n.dataset.nav); return; }
    const sb = e.target.closest('.sbar'); if (sb) { const s = st.slides.get(st.idx), r = sb.getBoundingClientRect(); if (s && s.video && s.video.duration) s.video.currentTime = (e.clientX - r.left) / r.width * s.video.duration; return; }
    const a = e.target.closest('[data-a]'); if (!a) return; const s = [...st.slides.values()].find(x => x.el.contains(a)); if (!s) return; const v = s.v;
    if (a.dataset.a === 'like') { const has = D.liked.some(x => x.id === v.id); if (has) { D.liked = D.liked.filter(x => x.id !== v.id); save(); } else addTo('liked', { ...v, short: true }); a.classList.toggle('on', !has); }
    if (a.dataset.a === 'sub') { toggleSub({ id: v.authorId, name: v.author }); a.classList.toggle('on', isSub(v.authorId)); }
    if (a.dataset.a === 'sound') { st.sound = !st.sound; soundIcons(); if (st.sound && s.video && s.video.paused) s.video.play().catch(() => {}); }
    if (a.dataset.a === 'share') share('https://www.youtube.com/shorts/' + v.id);
    if (a.dataset.a === 'full') go('watch', v.id);
  });
  // start: from a tapped Short (put it first), else the feed
  if (startId) { const known = (shelfItems || []).find(x => x.id === startId); add([known || { id: startId, title: '', thumb: `https://i.ytimg.com/vi/${startId}/hqdefault.jpg`, short: true }]); if (shelfItems) add(shelfItems.filter(x => x.id !== startId)); layout(); }
  if (!st.items.length) await more(); else more();
}

/* ---------------- settings ---------------- */
function settings() {
  const regions = ['US', 'GB', 'IN', 'CA', 'AU', 'DE', 'FR', 'JP', 'BR', 'MX', 'ES', 'IT', 'KR', 'NL', 'SE', 'PH', 'ID', 'NG', 'ZA'];
  main.innerHTML = `<div class="wrap" style="max-width:680px"><h2 class="sec">Kushtube settings</h2>
    <div class="chcard" style="display:block;cursor:auto">
    <p><label>Trending region&nbsp; <select id="reg" class="pill">${regions.map(r => `<option${r === D.set.region ? ' selected' : ''}>${r}</option>`).join('')}</select></label></p>
    <p><label>Video quality&nbsp; <select id="dq" class="pill">${['auto', '1080', '720', '480', '360', 'audio'].map(q => `<option value="${q}"${q === D.set.quality ? ' selected' : ''}>${q === 'auto' ? 'Auto (fastest for this screen)' : q === 'audio' ? 'Sound only' : q + 'p'}</option>`).join('')}</select></label></p>
    <p><label><input type="checkbox" id="sb" ${D.set.sponsor ? 'checked' : ''}> Skip sponsors, intros and “subscribe” reminders</label></p>
    <p><label><input type="checkbox" id="ap" ${D.set.autoplay ? 'checked' : ''}> Autoplay the next video</label></p></div>
    <p style="color:var(--text-2);font-size:13px">Kushtube finds videos with yt-dlp on your SanjivramOS server (Invidious and Piped as backups) and streams them through the server — no ads, and YouTube never sees this device. Subscriptions, history and likes are saved to your SanjivramOS account.</p>
    <p id="st" style="color:var(--text-3);font-size:13px"></p>
    <p style="display:flex;gap:8px;flex-wrap:wrap"><button class="pill" id="exp">Export subscriptions</button><button class="pill" id="imp">Import subscriptions</button></p></div>`;
  $('#reg').onchange = e => { D.set.region = e.target.value; save(); };
  $('#dq').onchange = e => { D.set.quality = e.target.value; save(); };
  $('#sb').onchange = e => { D.set.sponsor = e.target.checked; save(); };
  $('#ap').onchange = e => { D.set.autoplay = e.target.checked; save(); };
  api('status', { fresh: true }).then(j => { $('#st').textContent = `Server: ${j.last ? 'last answer from ' + j.last : 'ready'} · yt-dlp ${j.ytdlp ? (j.helper ? 'running ✓' : 'installed ✓') : 'not installed'}${j.lastErr ? ' · last problem: ' + j.lastErr : ''}`; }).catch(e => { $('#st').textContent = '⚠ ' + e.message; });
  $('#exp').onclick = () => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([JSON.stringify(D.subs, null, 2)], { type: 'application/json' })); a.download = 'kushtube-subscriptions.json'; a.click(); };
  $('#imp').onclick = () => { const i = document.createElement('input'); i.type = 'file'; i.accept = '.json,.csv'; i.onchange = async () => { const t = await i.files[0].text(); let n = 0; const addSub = (id, name) => { if (/^UC[\w-]{22}$/.test(id || '') && !isSub(id)) { D.subs.push({ id, name: name || id, thumb: '' }); n++; } }; try { const j = JSON.parse(t); for (const s of Array.isArray(j) ? j : j.subscriptions || []) addSub(s.id || s.channelId || (s.url && (/UC[\w-]{22}/.exec(s.url) || [])[0]), s.name || s.title); } catch { for (const line of t.split('\n')) { const m = /(UC[\w-]{22})[^,]*,(?:[^,]*,)?\s*"?([^",\n]+)/.exec(line); if (m) addSub(m[1], m[2]); } } save(); renderNav(); toast(`Imported ${n} subscription${n === 1 ? '' : 's'}`); }; i.click(); };
}

/* ---------------- keyboard on the watch page ---------------- */
addEventListener('keydown', e => {
  if (e.key === '/' && !/INPUT|SELECT/.test(e.target.tagName)) { e.preventDefault(); $('#q').focus(); return; }
  if (/INPUT|SELECT/.test(e.target.tagName) || view !== 'watch' || !W) return;
  const v = W.video, k = e.key.toLowerCase();
  if (k === 'k' || (k === ' ' && e.target === document.body)) { e.preventDefault(); v.paused ? v.play() : v.pause(); }
  if (k === 'j') v.currentTime -= 10; if (k === 'l') v.currentTime += 10;
  if (k === 'arrowleft') v.currentTime -= 5; if (k === 'arrowright') v.currentTime += 5;
  if (k === 'm') v.muted = !v.muted;
  if (k === 'f') (document.fullscreenElement ? document.exitFullscreen() : $('.player', main).requestFullscreen()).catch(() => {});
  if (k === 't') $('#theater').click();
  if (e.shiftKey && k === 'n' && W.v.related[0]) go('watch', W.v.related[0].id);
});
addEventListener('pagehide', savePos);

renderNav();
const first = parseHash(); go(first.v, first.arg, false); history.replaceState(first, '', location.hash || '#home');
