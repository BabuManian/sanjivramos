<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Kushtube</title>
<link rel="preconnect" href="https://i.ytimg.com">
<style>
/* Colours come from SanjivramOS (copied from the desktop's theme at start-up and whenever it changes). */
:root{color-scheme:dark;--accent:#faa41a;--accent-rgb:250,164,26;--on-accent:#1b1a19;--text:#f2f0ee;--text-2:#b3ada8;--text-3:#857f7a;
  --surface:#333130;--surface-2:#2b2928;--surface-3:#43403e;--border:rgba(255,255,255,.07);--hover:rgba(255,255,255,.07);
  --font:"Fira Sans",Ubuntu,"Noto Sans","Segoe UI",Roboto,sans-serif;
  --bg:color-mix(in srgb,var(--surface-2) 70%,#000);--card:var(--surface-2);--r:16px;--ease:cubic-bezier(.2,.8,.2,1)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font:14px/1.45 var(--font);overflow:hidden}
button{font:inherit;color:inherit;border:none;background:none;cursor:pointer;padding:0}
input,select{font:inherit;color:inherit}
a{color:var(--accent);text-decoration:none}
svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
#app{display:grid;grid-template-columns:76px minmax(0,1fr);grid-template-rows:60px minmax(0,1fr);height:100%}
/* top bar */
header{grid-column:1/3;display:flex;align-items:center;gap:14px;padding:0 16px 0 14px;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(14px);z-index:5}
.brand{display:flex;align-items:center;gap:9px;cursor:pointer;user-select:none;flex:none}
.mark{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:conic-gradient(from 210deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#ff3d6e),var(--accent));box-shadow:0 4px 18px rgba(var(--accent-rgb),.35)}
.mark svg{width:16px;height:16px;fill:var(--on-accent);stroke:none;margin-left:2px}
.word{font-weight:800;font-size:20px;letter-spacing:-.6px}.word b{display:inline-block;margin-left:2px;padding:0 7px 1px;border-radius:8px;background:var(--accent);color:var(--on-accent);font-weight:800;transform:rotate(-3deg)}
#sform{flex:1;max-width:600px;margin:0 auto;position:relative}
#sform svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-3);pointer-events:none}
#q{width:100%;height:40px;border-radius:20px;border:1px solid var(--border);background:var(--surface-2);padding:0 16px 0 42px;outline:none;transition:border-color .2s,box-shadow .2s}
#q:focus{border-color:rgba(var(--accent-rgb),.7);box-shadow:0 0 0 4px rgba(var(--accent-rgb),.15)}
.ib{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--text-2);transition:background .15s}
.ib:hover{background:var(--hover);color:var(--text)}
/* side rail */
#rail{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;overflow:auto}
#rail button{width:64px;padding:8px 0 6px;border-radius:14px;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:11px;color:var(--text-2)}
#rail button:hover{background:var(--hover);color:var(--text)}
#rail button i{display:grid;place-items:center;width:46px;height:28px;border-radius:14px;transition:background .2s}
#rail button.on{color:var(--text);font-weight:600}#rail button.on i{background:rgba(var(--accent-rgb),.22);color:var(--accent)}
#rail .sep{width:36px;height:1px;background:var(--border);margin:6px 0}
#rail .ch{width:40px;height:40px;padding:0;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:var(--surface-3);font-weight:700;font-size:14px}
#rail .ch img{width:100%;height:100%;object-fit:cover}
main{overflow:auto;position:relative;border-top-left-radius:22px;background:var(--bg);scrollbar-width:thin}
.wrap{padding:18px 22px 40px;max-width:1800px;margin:0 auto}
/* home */
.hero{position:relative;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:22px;align-items:center;padding:18px;border-radius:24px;overflow:hidden;margin-bottom:26px;cursor:pointer;isolation:isolate}
.hero .bgimg{position:absolute;inset:-40px;background:center/cover;filter:blur(40px) saturate(1.4);opacity:.45;z-index:-1}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(0,0,0,.35));z-index:-1}
.hero .th{border-radius:18px;box-shadow:0 20px 50px rgba(0,0,0,.45)}
.hero .tag{display:inline-flex;gap:6px;align-items:center;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.hero h1{font-size:clamp(20px,2.4vw,32px);line-height:1.15;margin:8px 0 10px;letter-spacing:-.5px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.hero p{margin:0 0 16px;color:var(--text-2)}
.pill{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 16px;border-radius:19px;background:var(--surface-3);font-weight:600;white-space:nowrap;transition:transform .15s,background .15s}
.pill:hover{background:color-mix(in srgb,var(--surface-3) 80%,#fff)}.pill:active{transform:scale(.96)}
.pill.acc{background:var(--accent);color:var(--on-accent)}.pill.acc:hover{background:color-mix(in srgb,var(--accent) 88%,#fff)}
.pill svg{width:18px;height:18px}
.shelf{margin:0 0 26px}.shelf h3,.sec{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-size:18px}
.shelf h3 svg{color:var(--accent)}
.srow{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(150px,170px);gap:12px;overflow-x:auto;padding-bottom:6px;scroll-snap-type:x proximity;scrollbar-width:none}
.srow::-webkit-scrollbar{display:none}
.stile{position:relative;aspect-ratio:9/16;border-radius:16px;overflow:hidden;background:var(--surface-3);cursor:pointer;scroll-snap-align:start}
.stile img{width:100%;height:100%;object-fit:cover;transition:transform .3s var(--ease)}.stile:hover img{transform:scale(1.05)}
.stile b{position:absolute;left:0;right:0;bottom:0;padding:40px 10px 10px;font-size:13px;line-height:1.3;background:linear-gradient(transparent,rgba(0,0,0,.85));display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.chips{display:flex;gap:8px;overflow-x:auto;margin-bottom:18px;scrollbar-width:none;padding:2px}
.chips::-webkit-scrollbar{display:none}
.chips button{flex:none;height:34px;padding:0 14px;border-radius:17px;background:var(--surface-2);border:1px solid var(--border);font-weight:600;font-size:13px;transition:all .15s}
.chips button:hover{background:var(--surface-3)}
.why{display:block;color:#faa41a;font-size:11.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.simrow{display:flex;gap:8px;overflow-x:auto;padding:2px 0 14px;scrollbar-width:none}.simrow h4{margin:0 6px 0 0;align-self:center;white-space:nowrap;font-size:13px;color:var(--text-2)}
.simrow a{flex:none;display:flex;align-items:center;gap:7px;height:34px;padding:0 13px 0 4px;border-radius:17px;background:var(--surface-2);border:1px solid var(--border);font-weight:600;font-size:13px;color:inherit;text-decoration:none}.simrow a .av{width:26px;height:26px;font-size:12px}.chips button.on{background:var(--text);color:var(--bg);border-color:transparent}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:26px 18px}
.card{cursor:pointer;min-width:0;border-radius:var(--r);transition:transform .2s var(--ease)}
.card:hover{transform:translateY(-3px)}
.th{position:relative;aspect-ratio:16/9;border-radius:var(--r);overflow:hidden;background:var(--surface-3)}
.th img{width:100%;height:100%;object-fit:cover;display:block}
.card:hover .th{box-shadow:0 0 0 2px rgba(var(--accent-rgb),.8),0 12px 30px rgba(0,0,0,.35)}
.len{position:absolute;right:8px;bottom:8px;background:rgba(0,0,0,.78);backdrop-filter:blur(4px);padding:2px 7px;border-radius:7px;font-size:12px;font-weight:700}
.len.live{background:#e11d48}
.prog{position:absolute;left:0;bottom:0;height:4px;background:var(--accent)}
.meta{display:flex;gap:10px;margin-top:10px}
.av{width:36px;height:36px;border-radius:50%;flex:none;display:grid;place-items:center;font-weight:700;color:var(--on-accent);font-size:14px}
.meta b{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:15px;line-height:1.3}
.meta small{display:block;color:var(--text-2);font-size:13px;margin-top:3px}
.meta small a{color:inherit}.meta small a:hover{color:var(--accent)}
.chcard{display:flex;align-items:center;gap:16px;padding:14px;border-radius:var(--r);cursor:pointer;background:var(--card);margin-bottom:10px}
.chcard img{width:72px;height:72px;border-radius:50%;object-fit:cover}
.empty{color:var(--text-2);text-align:center;padding:70px 20px}
.err{background:rgba(225,29,72,.12);border:1px solid rgba(225,29,72,.4);padding:14px 16px;border-radius:14px;margin:14px 0;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.skel{background:linear-gradient(90deg,var(--surface-2),var(--surface-3),var(--surface-2));background-size:200% 100%;animation:sk 1.1s infinite;border-radius:var(--r)}
@keyframes sk{to{background-position:-200% 0}}
/* watch */
.watch{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:24px;padding:18px 22px 40px;max-width:1800px;margin:0 auto}
.watch.theater{grid-template-columns:minmax(0,1fr)}
.player{position:relative;background:#000;border-radius:20px;overflow:hidden;aspect-ratio:16/9;box-shadow:0 18px 60px rgba(var(--accent-rgb),.14),0 10px 30px rgba(0,0,0,.5)}
.watch.theater .player{aspect-ratio:auto;height:min(76vh,56.25vw)}
.player video{width:100%;height:100%;display:block;background:#000}
.player .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;transition:opacity .3s}
.spin{position:absolute;left:50%;top:50%;width:46px;height:46px;margin:-23px;border-radius:50%;border:4px solid rgba(255,255,255,.2);border-top-color:var(--accent);animation:rot .8s linear infinite;pointer-events:none}
@keyframes rot{to{transform:rotate(360deg)}}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:12px 0 6px}
.tools select{height:36px;border-radius:18px;border:none;background:var(--surface-3);padding:0 12px;outline:none}
.vt{font-size:21px;font-weight:700;letter-spacing:-.3px;margin:10px 0 12px;line-height:1.3}
.owner{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.owner img,.owner .av{width:44px;height:44px;border-radius:50%;object-fit:cover;cursor:pointer}
.owner .n{cursor:pointer;min-width:0}.owner .n b{display:block}.owner .n small{color:var(--text-2)}
.desc{background:var(--card);border-radius:var(--r);padding:14px;margin-top:14px;white-space:pre-wrap;word-break:break-word;max-height:118px;overflow:hidden;cursor:pointer;position:relative}
.desc:after{content:"…more";position:absolute;right:12px;bottom:10px;padding-left:30px;background:linear-gradient(90deg,transparent,var(--card) 30%);font-weight:700}
.desc.open{max-height:none;cursor:auto}.desc.open:after{display:none}
.desc .st{font-weight:700;display:block;margin-bottom:6px}
.side h4{margin:0 0 12px;font-size:15px;color:var(--text-2)}
.side .card{display:grid;grid-template-columns:168px minmax(0,1fr);gap:10px;margin-bottom:12px}
.side .card:hover{transform:none}.side .th{border-radius:12px}.side .meta{margin:0}.side .meta .av{display:none}.side .meta b{font-size:14px}
.toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:10px 18px;border-radius:14px;font-weight:600;z-index:60;box-shadow:0 10px 30px rgba(0,0,0,.5);animation:tin .25s var(--ease);max-width:90vw}
@keyframes tin{from{opacity:0;transform:translate(-50%,10px)}}
/* channel */
.banner{height:clamp(90px,16vw,200px);background:var(--surface-3) center/cover;border-radius:22px}
.chhead{display:flex;align-items:center;gap:18px;margin:18px 0;flex-wrap:wrap}
.chhead img{width:96px;height:96px;border-radius:50%;object-fit:cover}
/* Shorts: a pager — only the current, previous and next Short exist, swipe/scroll/arrow keys move one at a time */
#shorts{position:absolute;inset:0;overflow:hidden;touch-action:none;user-select:none;background:#000}
.slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:16px;padding:14px 0;will-change:transform}
.sbox{position:relative;height:100%;aspect-ratio:9/16;max-width:100%;border-radius:20px;overflow:hidden;background:#111}
.sbox video,.sbox .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.sbox .ov{position:absolute;left:0;right:0;bottom:0;padding:70px 16px 22px;background:linear-gradient(transparent,rgba(0,0,0,.8));pointer-events:none}
.sbox .ov b{display:block;font-size:15px;margin-bottom:8px;text-shadow:0 1px 4px #000}.sbox .ov span{pointer-events:auto;cursor:pointer;font-weight:700}
.sbar{position:absolute;left:0;right:0;bottom:0;height:14px;cursor:pointer;display:flex;align-items:flex-end}
.sbar i{display:block;height:3px;background:var(--accent);width:0}
.sbox .big{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:76px;height:76px;border-radius:50%;background:rgba(0,0,0,.5);display:grid;place-items:center;pointer-events:none}
.sbox .big svg{width:34px;height:34px;fill:#fff;stroke:none}
.snd{position:absolute;top:14px;left:14px;display:flex;align-items:center;gap:6px;background:rgba(0,0,0,.6);padding:7px 12px;border-radius:16px;font-weight:700;font-size:13px}
.sacts{display:flex;flex-direction:column;gap:16px;align-items:center;align-self:flex-end;padding-bottom:10px}
.sacts button{display:flex;flex-direction:column;align-items:center;gap:5px;font-size:12px;font-weight:600;color:#fff}
.sacts button i{display:grid;place-items:center;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.12);transition:transform .15s,background .15s}
.sacts button:active i{transform:scale(.9)}.sacts button.on i{background:var(--accent);color:var(--on-accent)}
.snav{position:absolute;right:22px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:12px;z-index:3}
.snav button{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.12);display:grid;place-items:center;color:#fff}
.snav button:hover{background:rgba(255,255,255,.22)}
#bnav{display:none}
@media (max-width:820px){
  #app{grid-template-columns:minmax(0,1fr);grid-template-rows:56px minmax(0,1fr) 60px}
  header{gap:8px;padding:0 10px}.word{display:none}
  #rail{display:none}main{border-radius:0}
  #bnav{display:flex;background:var(--bg);border-top:1px solid var(--border);padding-bottom:env(safe-area-inset-bottom)}
  #bnav button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:11px;color:var(--text-2)}
  #bnav button i{display:grid;place-items:center;width:52px;height:28px;border-radius:14px}
  #bnav button.on{color:var(--text);font-weight:700}#bnav button.on i{background:rgba(var(--accent-rgb),.22);color:var(--accent)}
  .wrap{padding:12px 12px 30px}.grid{grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:20px 12px}
  .hero{grid-template-columns:1fr;padding:12px;gap:12px}.hero p{display:none}
  .watch{grid-template-columns:minmax(0,1fr);padding:0 0 30px}.watch .info>*:not(.player),.watch .side{padding:0 12px}.player{border-radius:0}
  .slide{padding:0}.sbox{border-radius:0;width:100%;aspect-ratio:auto}
  .sacts{position:absolute;right:8px;bottom:84px;z-index:2}.snav{display:none}
}
</style></head>
<body>
<div id="app">
  <header>
    <div class="brand" data-go="home" title="Kushtube home"><div class="mark"><svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg></div><div class="word">kush<b>tube</b></div></div>
    <form id="sform" role="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input id="q" placeholder="Search Kushtube" autocomplete="off" enterkeyhint="search"></form>
    <button class="ib" id="setBtn" title="Settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></button>
  </header>
  <nav id="rail"></nav>
  <main id="main"></main>
  <nav id="bnav"></nav>
</div>
<script>
(() => {
'use strict';
const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => [...r.querySelectorAll(s)], main = $('#main');
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const I = {
  home: '<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  shorts: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  subs: '<rect x="3" y="6" width="18" height="14" rx="3"/><path d="M8 2l4 4 4-4M10 11l5 2.5-5 2.5z"/>',
  lib: '<path d="M4 4h4v16H4zM10 4h4v16h-4zM16 5l4 1-3 14-4-1"/>',
  play: '<path d="M7 4l13 8-13 8z" fill="currentColor"/>', pause: '<path d="M7 4h3v16H7zM14 4h3v16h-3z" fill="currentColor"/>',
  like: '<path d="M12 21s-8-5.2-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.8-8 11-8 11z"/>',
  later: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', share: '<path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13"/>',
  plus: '<path d="M12 5v14M5 12h14"/>', check: '<path d="M5 12l5 5 9-10"/>', vol: '<path d="M4 9h4l5-4v14l-5-4H4zM17 8a5 5 0 0 1 0 8"/>', mute: '<path d="M4 9h4l5-4v14l-5-4H4zM22 9l-6 6M16 9l6 6"/>',
  up: '<path d="M6 15l6-6 6 6"/>', down: '<path d="M6 9l6 6 6-6"/>', theater: '<rect x="2" y="6" width="20" height="12" rx="2"/>', pip: '<rect x="2" y="4" width="20" height="16" rx="2"/><rect x="12" y="11" width="7" height="6" rx="1" fill="currentColor"/>',
  full: '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>', hist: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2"/>', trend: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>',
};
const ic = (k, extra = '') => `<svg viewBox="0 0 24 24"${extra}>${I[k]}</svg>`;

/* ---------------- look: follow the SanjivramOS theme ---------------- */
const THEME_VARS = ['--accent', '--accent-rgb', '--on-accent', '--font', '--text', '--text-2', '--text-3', '--surface', '--surface-2', '--surface-3', '--border', '--hover'];
function syncTheme() {
  try {
    const pd = parent !== window && parent.document.documentElement; if (!pd) return;
    const cs = getComputedStyle(pd);
    for (const v of THEME_VARS) { const x = cs.getPropertyValue(v).trim(); if (x) document.documentElement.style.setProperty(v, x); }
    document.documentElement.style.colorScheme = pd.dataset.theme === 'light' ? 'light' : 'dark';
  } catch {}
}
syncTheme();
try { if (parent !== window) new parent.MutationObserver(() => syncTheme()).observe(parent.document.documentElement, { attributes: true, attributeFilter: ['style', 'class', 'data-theme', 'data-accent'] }); } catch {}

/* ---------------- your stuff (webos.* keys sync to your SanjivramOS account) ---------------- */
const KEY = 'webos.tube';
const DEF = { subs: [], history: [], later: [], liked: [], progress: {}, set: { quality: 'auto', autoplay: true, sponsor: true, speed: 1, region: 'US' } };
let D; try { D = Object.assign({}, DEF, JSON.parse(localStorage.getItem(KEY)) || {}); D.set = Object.assign({}, DEF.set, D.set || {}); } catch { D = JSON.parse(JSON.stringify(DEF)); }
let saveT = null; const save = () => { clearTimeout(saveT); saveT = setTimeout(() => { try { localStorage.setItem(KEY, JSON.stringify(D)); } catch {} }, 300); };

