    let j = {}; try { j = await r.json(); } catch {}
    if (r.status === 404 && !j.error) throw new Error('Kushtube needs the updated server — in Termux run: sanjivramos restart');
    if (!r.ok) throw new Error(j.error || `Error ${r.status}`);
