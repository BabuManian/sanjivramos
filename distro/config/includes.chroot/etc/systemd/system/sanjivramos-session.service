[Unit]
Description=SanjivramOS desktop (Electron)
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=sanjivram
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=~
Environment=XDG_SESSION_TYPE=x11
ExecStart=/usr/lib/sanjivramos/start-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
