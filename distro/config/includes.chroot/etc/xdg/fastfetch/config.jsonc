// SanjivramOS fastfetch — "I use Arch, btw." (It's really Debian underneath.)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "padding": { "right": 2 } },
  "display": { "separator": " ", "color": { "keys": "blue", "title": "blue" } },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "key": "OS", "format": "Arch Linux x86_64" },
    "host",
    { "type": "command", "key": "Kernel", "text": "uname -r | sed -E 's/\\+deb[^-]*//; s/-(amd64|cloud-amd64|rt-amd64)$/-arch1-1/'" },
    "uptime",
    { "type": "command", "key": "Packages", "text": "echo \"$(dpkg-query -f '.\\n' -W 2>/dev/null | wc -l) (pacman)\"" },
    "shell",
    "display",
    { "type": "custom", "key": "DE", "format": "SanjivramOS (Electron)" },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "break",
    "colors"
  ]
}
