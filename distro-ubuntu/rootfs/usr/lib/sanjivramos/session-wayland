#!/bin/sh
# Wayland session (run by labwc): the SanjivramOS Electron shell, natively on Wayland. X11 apps use XWayland.
ENVF="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sanjivramos-session.env"
printf 'SJ_SESSION=wayland\nWAYLAND_DISPLAY=%s\nDISPLAY=%s\nLABWC_PID=%s\nXDG_SESSION_TYPE=wayland\nMOZ_ENABLE_WAYLAND=1\nQT_QPA_PLATFORM=wayland;xcb\nELECTRON_OZONE_PLATFORM_HINT=auto\n' \
  "$WAYLAND_DISPLAY" "$DISPLAY" "$LABWC_PID" > "$ENVF"
command -v dbus-update-activation-environment >/dev/null && dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP 2>/dev/null
/usr/lib/sanjivramos/display-restore   # screen settings from Settings → This Computer → Display
/usr/lib/sanjivramos/live-installer 12 &
SHELL_DIR=/opt/sanjivramos/app/distro/shell
ELECTRON="$SHELL_DIR/node_modules/electron/dist/electron"
# While the boot updater is replacing the app, Electron can be briefly missing: wait for it (at most 6 minutes).
if [ ! -x "$ELECTRON" ]; then
  for i in $(seq 360); do [ -e /run/sanjivramos/done ] && break; systemctl -q is-active sanjivramos-update.service || break; sleep 1; done
fi
[ -x "$ELECTRON" ] || exec xterm -fa 'Fira Mono' -fs 11 -maximized -e sh -c 'echo "SanjivramOS shell is missing. Connect to the internet and run: sudo systemctl restart sanjivramos-update"; exec bash'
exec "$ELECTRON" "$SHELL_DIR" --ozone-platform=wayland --enable-wayland-ime
