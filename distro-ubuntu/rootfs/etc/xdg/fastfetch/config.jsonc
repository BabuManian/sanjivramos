// SanjivramOS fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "/usr/share/sanjivramos/fastfetch-logo.txt", "color": { "1": "38;2;250;164;26", "2": "38;2;27;26;25" }, "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "38;2;250;164;26", "title": "38;2;250;164;26" } },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;133;127;122m────────────────────────────────" },
    { "type": "os", "key": "OS", "format": "SanjivramOS {version-id} {arch}" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Display" },
    { "type": "custom", "key": "Desktop", "format": "SanjivramOS Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "localip", "key": "Local IP" },
    { "type": "battery", "key": "Battery" },
    "break",
    "colors"
  ]
}
